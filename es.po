"# Respuestas completas: ACP, sandbox estricto, sin herramientas integradas, configuración de Grok revisada\n"
"[providers.models.grok_cli.default]\n"
"model = \"grok-4.5\"\n"
"binary_path = \"/home/you/.grok/bin/grok\"\n"
"working_directory = \"/path/to/agents/default/workspace\"\n"
"\n"
"# Comprobación previa REPLY / NO_REPLY - API (formato estable). Reutiliza un alias HTTP\n"
